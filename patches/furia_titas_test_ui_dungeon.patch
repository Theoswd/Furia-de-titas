-# Emoji ou ASCII.
+# Cor unica para o nome de cada conta durante esta sessao do painel.
+# WSL/Windows Terminal e Termux normalmente suportam 256 cores. Em terminais
+# mais simples cai automaticamente para a paleta ANSI basica.
+_NAME_COLOR_SEED=$(( ($$ + $(date +%s)) % 20 ))
+case "${TERM:-}" in
+    *256color*|xterm*|screen*|tmux*) _NAME_COLOR_256=1 ;;
+    *)                               _NAME_COLOR_256=0 ;;
+esac
+nome_cor_idx() {
+    _ci=$(( ($1 - 1 + _NAME_COLOR_SEED) % 20 ))
+    if [ "$_NAME_COLOR_256" = 1 ]; then
+        case "$_ci" in
+            0)  _NC='\033[38;5;39m'  ;; 1)  _NC='\033[38;5;45m'  ;;
+            2)  _NC='\033[38;5;51m'  ;; 3)  _NC='\033[38;5;81m'  ;;
+            4)  _NC='\033[38;5;75m'  ;; 5)  _NC='\033[38;5;69m'  ;;
+            6)  _NC='\033[38;5;99m'  ;; 7)  _NC='\033[38;5;135m' ;;
+            8)  _NC='\033[38;5;171m' ;; 9)  _NC='\033[38;5;207m' ;;
+            10) _NC='\033[38;5;203m' ;; 11) _NC='\033[38;5;209m' ;;
+            12) _NC='\033[38;5;214m' ;; 13) _NC='\033[38;5;220m' ;;
+            14) _NC='\033[38;5;190m' ;; 15) _NC='\033[38;5;154m' ;;
+            16) _NC='\033[38;5;118m' ;; 17) _NC='\033[38;5;48m'  ;;
+            18) _NC='\033[38;5;49m'  ;; *)  _NC='\033[38;5;87m'  ;;
+        esac
+    else
+        case $((_ci % 6)) in
+            0) _NC="$C_CYAN" ;; 1) _NC="$C_GREEN" ;; 2) _NC="$C_YELLOW" ;;
+            3) _NC="$C_MAG"  ;; 4) _NC="$C_BLUE"  ;; *) _NC="$C_WHITE" ;;
+        esac
+    fi
+}
