+    # SOMENTE GOLPES GRATUITOS. A pagina inicial pode exibir primeiro
+    # /clandungeon/executar; nesse caso entramos nela e so depois procuramos
+    # /clandungeon/attack/?r=N. Nunca segue links de compra/pagamento.
     _br=$(($(date +%s) + 180))
     _n=0
     while [ "$(date +%s)" -lt "$_br" ] && [ "$_n" -lt 10 ]; do
         _cl=`grep -o -E '/clandungeon/attack/[?]r=[0-9]+' "$TMP/DUNGEON" | sed -n 1p`
+
+        if [ -z "$_cl" ]; then
+            _exec=`grep -o -E '/clandungeon/executar(/[?]r=[0-9]+)?' "$TMP/DUNGEON" | sed -n 1p`
+            if [ -n "$_exec" ]; then
+                printf "Masmorra: entrando na execucao\n"
+                if ! fetch_page "$_exec" "$TMP/DUNGEON"; then
+                    printf "Masmorra: falha ao abrir /clandungeon/executar\n"
+                    break
+                fi
+                _cl=`grep -o -E '/clandungeon/attack/[?]r=[0-9]+' "$TMP/DUNGEON" | sed -n 1p`
+            fi
+        fi
+
         [ -n "$_cl" ] || break
 
         if ! fetch_page "$_cl" "$TMP/DUNGEON"; then
@@ -13,15 +27,22 @@
 
