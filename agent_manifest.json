{
  "name": "Furia-de-titas",
  "channel": "test",
  "version": "2.1.2-missions-clanfight",
  "shell": "posix-sh",
  "platforms": ["wsl", "termux"],
  "branch": "feat/priority-state-scheduler",
  "modules": [
    "run.sh",
    "priority.sh",
    "state.sh",
    "action_runner.sh",
    "resource_guard.sh",
    "blessing.sh",
    "campaign.sh",
    "career.sh",
    "arena.sh",
    "cave.sh",
    "clanquest.sh",
    "clanid.sh",
    "clanfight.sh",
    "check.sh",
    "specialevent.sh",
    "test_agent.sh",
    "test_agent_runtime.sh"
  ],
  "safety": {
    "legacy_scheduler_fallback": false,
    "blessing_auto_gold": false,
